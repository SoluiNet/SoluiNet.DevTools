<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <!-- Cross-platform NLog configuration - fallback only -->
  <!-- The application will configure NLog programmatically for better cross-platform support -->
  
  <variable name="logDirectory" value="${basedir}/logs"/>
  <variable name="platformLayout" value="${longdate} [${processid}] ${uppercase:${level}} [${environment:PROCESSOR_ARCHITECTURE:whenEmpty=${environment:PROCESSOR_ARCHITEW6432:whenEmpty=Unknown}}] ${message} (${logger})"/>

  <targets>
    <!-- Console target for immediate feedback with basic platform info -->
    <target xsi:type="Console" name="console"
            layout="${longdate} ${uppercase:${level}} [${environment:OS:whenEmpty=Unknown}] ${message} ${exception:format=tostring}" />
    
    <!-- Fallback file target using relative paths with enhanced layout -->
    <target xsi:type="File" name="fallbackLog" 
            fileName="${logDirectory}/console_${shortdate}.log"
            layout="${platformLayout}"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="7"
            concurrentWrites="true"
            keepFileOpen="false"
            createDirs="true" />
            
    <!-- Fallback error log for critical issues -->
    <target xsi:type="File" name="fallbackErrorLog" 
            fileName="${logDirectory}/console_errors_${shortdate}.log"
            layout="${longdate} [${processid}] ${uppercase:${level}} [${environment:OS:whenEmpty=Unknown}] ${message}${newline}${exception:format=tostring}"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="14"
            concurrentWrites="true"
            keepFileOpen="false"
            createDirs="true" />
  </targets>

  <rules>
    <!-- Error logging to both console and error file -->
    <logger name="*" minlevel="Error" writeTo="console" />
    <logger name="*" minlevel="Error" writeTo="fallbackErrorLog" />
    
    <!-- Warning logging to console -->
    <logger name="*" minlevel="Warn" maxlevel="Warn" writeTo="console" />
    
    <!-- All logging to main file -->
    <logger name="*" minlevel="Debug" writeTo="fallbackLog" />
    
    <!-- Filter out noisy loggers -->
    <logger name="Quartz*" minlevel="Trace" maxlevel="Info" final="true" />
    <logger name="Microsoft.Extensions.*" minlevel="Trace" maxlevel="Info" final="true" />
  </rules>
</nlog>