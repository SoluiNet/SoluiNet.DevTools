<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <!-- Cross-platform NLog configuration - fallback only -->
  <!-- The application will configure NLog programmatically for better cross-platform support -->
  
  <variable name="logDirectory" value="${basedir}/logs"/>

  <targets>
    <!-- Console target for immediate feedback -->
    <target xsi:type="Console" name="console"
            layout="${longdate} ${uppercase:${level}} ${message} ${exception:format=tostring}" />
    
    <!-- Fallback file target using relative paths -->
    <target xsi:type="File" name="fallbackLog" 
            fileName="${logDirectory}/console_${shortdate}.log"
            layout="${longdate} [${processid}] ${uppercase:${level}} ${message} (${logger})"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="7" />
  </targets>

  <rules>
    <!-- Console output for errors and warnings -->
    <logger name="*" minlevel="Warn" writeTo="console" />
    
    <!-- File output for all messages -->
    <logger name="*" minlevel="Debug" writeTo="fallbackLog" />
    
    <!-- Filter out Quartz noise -->
    <logger name="Quartz*" minlevel="Trace" maxlevel="Info" final="true" />
  </rules>
</nlog>